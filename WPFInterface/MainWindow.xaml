<Window x:Class="WPFInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFInterface"
        mc:Ignorable="d"
        Title="Generics" Height="600" Width="800"
        FontSize="20">
    <Grid>
        <TabControl>
            <TabItem Header="Интеграл">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Функция" >
                        <ComboBox SelectionChanged="Try_Calc_Integral" Name="Cb_Integral">
                            <ComboBoxItem Content="x^2" IsSelected="True"/>
                            <ComboBoxItem Content="x" />
                            <ComboBoxItem Content="sin(x)" />
                            <ComboBoxItem Content="cos(x)" />
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="Нижний предел интегрирования">
                        <TextBox TextChanged="Try_Calc_Integral" Name="Tx_Left"/>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Верхний предел интегрирования">
                        <TextBox TextChanged="Try_Calc_Integral" Name="Tx_Right"/>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Header="Количество шагов">
                        <TextBox TextChanged="Try_Calc_Integral" Name="Tx_Steps"/>
                    </GroupBox>
                    <GroupBox Grid.Row="4" Header="Параллельность">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="Rb_Parallel" VerticalContentAlignment="Center" Content="Параллельно" IsChecked="True" Checked="Try_Calc_Integral"/>
                            <RadioButton VerticalContentAlignment="Center" Content="Не параллельно" Checked="Try_Calc_Integral"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="5" Header="Вывод">
                        <TextBox Name="Tx_Integral_Output" IsReadOnly="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Коллекции">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Тип">
                        <ComboBox Name="Cb_Collection" SelectionChanged="Clear_Collection">
                            <ComboBoxItem Content="Стэк" IsSelected="True"/>
                            <ComboBoxItem Content="Очередь"/>
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="Действия">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Добавить" Click="Add_Element" Margin="2"/>
                            <Button Content="Удалить" Click="Remove_Element" Margin="2"/>
                            <Button Content="Очистить" Click="Clear_Collection" Margin="2"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Организация" >
                        <WrapPanel Orientation="Horizontal" Name="WrP_Collection" />
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Сортировка">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Тип данных">
                        <ComboBox Name="Cb_Sorting" SelectionChanged="Sorting_Clear">
                            <ComboBoxItem Content="Студент" IsSelected="True" />
                            <ComboBoxItem Content="Автомобиль" />
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="Тип сортировки">
                        <ComboBox Name="Cb_Sort_Type">
                            <ComboBoxItem Content="Фамилия" IsSelected="True"/>
                            <ComboBoxItem Content="Длина Фамилии"/>
                            <ComboBoxItem Content="Имя"/>
                            <ComboBoxItem Content="Длина Имени"/>
                            <ComboBoxItem Content="Отчество"/>
                            <ComboBoxItem Content="Длина Отчества"/>
                            <ComboBoxItem Content="Возраст"/>
                            <ComboBoxItem Content="Рост"/>
                            <ComboBoxItem Content="Вес"/>
                            <ComboBoxItem Content="Средний Балл"/>
                            <ComboBoxItem Content="Комплексный"/>
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Метод Сортироваки">
                        <ComboBox Name="Cb_Sort_Method" >
                            <ComboBoxItem Content="Пузырьковая" IsSelected="True"/>
                            <ComboBoxItem Content="Вставками"/>
                            <ComboBoxItem Content="Слиянием"/>
                            <ComboBoxItem Content="Быстрая"/>
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Header="Действия">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Заполнить" Click="Sorting_Fill" Margin="2"/>
                            <Button Content="Сортировать" Click="Sorting_Sort" Margin="2"/>
                            <Button Content="Очистить" Click="Sorting_Clear" Margin="2"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="4" Header="Вывод">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Name="Tg_Ascending" Content="По Возрастанию" Margin="2"/>
                            <TextBox Name="Tx_Sorting_Result" Width="300" Margin="2" IsReadOnly="True"/>    
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="5" Header="Организация">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel Orientation="Horizontal" Name="WrP_Sorting"/>    
                        </ScrollViewer>
                        
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
